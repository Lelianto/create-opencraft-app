{
  "name": "@antihero/cli",
  "version": "0.3.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lelianto/create-opencraft-app.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/Lelianto/create-opencraft-app#readme",
  "bugs": {
    "url": "https://github.com/Lelianto/create-opencraft-app/issues"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "opencraft": "dist/src/bin.js"
  },
  "exports": {
    ".": "./dist/src/index.js"
  },
  "files": [
    "dist",
    "templates",
    "registry",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/src/bin.js && rm -rf templates registry && cp -R ../../templates templates && cp -R ../../registry registry",
    "type-check": "tsc -p tsconfig.json --pretty false",
    "lint": "eslint src test",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests",
    "test:integration": "vitest run test/integration.test.ts"
  },
  "dependencies": {
    "@antihero/config": "workspace:*",
    "@antihero/registry": "workspace:*",
    "@antihero/shared": "workspace:*",
    "@clack/prompts": "0.11.0",
    "commander": "14.0.0",
    "diff": "8.0.2"
  },
  "devDependencies": {
    "@types/diff": "8.0.0",
    "@types/node": "20.19.9",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
