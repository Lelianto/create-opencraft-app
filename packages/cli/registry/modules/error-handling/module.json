{
  "name": "error-handling",
  "version": "1.0.0",
  "description": "Typed AppError, safe client error boundary, and secure API error mapping",
  "supportedArchitectures": ["atomic", "feature", "hybrid"],
  "dependencies": [],
  "npmDependencies": {},
  "npmDevDependencies": {},
  "environmentVariables": [],
  "files": {
    "atomic": [
      { "source": "templates/errors.ts", "target": "{{aliases.lib}}/errors.ts" },
      { "source": "templates/error.tsx", "target": "src/app/error.tsx" }
    ],
    "feature": [
      { "source": "templates/errors.ts", "target": "{{aliases.lib}}/errors.ts" },
      { "source": "templates/error.tsx", "target": "src/app/error.tsx" }
    ],
    "hybrid": [
      { "source": "templates/errors.ts", "target": "{{aliases.lib}}/errors.ts" },
      { "source": "templates/error.tsx", "target": "src/app/error.tsx" }
    ]
  },
  "instructions": [
    "Throw AppError with an allowed code; route handlers should map it with toApiFailure() so no stack trace reaches the client.",
    "Never log token, cookie, or raw secret values; log safe metadata only."
  ]
}
