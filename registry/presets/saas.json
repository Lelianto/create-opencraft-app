{
  "$schema": "https://opencraft.dev/schema/preset.schema.json",
  "name": "saas",
  "description": "Full SaaS app: Google auth, dashboard, roles, user profiles, audited CRUD with search, pagination, rate limiting, and security hardening on Supabase.",
  "architecture": "hybrid",
  "backend": "supabase",
  "auth": "google",
  "storage": "supabase",
  "modules": [
    "auth-pages",
    "protected-routes",
    "role-permission",
    "user-profile",
    "dashboard",
    "crud-example",
    "data-table",
    "pagination",
    "search-filter",
    "audit-log",
    "error-handling",
    "rate-limit",
    "ssrf-protection",
    "security-headers",
    "api-response",
    "input-validation",
    "confirmation-dialog",
    "deploy-vercel"
  ]
}
