{
  "name": "audit-log",
  "version": "2.0.0",
  "description": "Secret-redacting audit logger for security-sensitive operations",
  "supportedArchitectures": [
    "atomic",
    "feature",
    "hybrid"
  ],
  "dependencies": [],
  "npmDependencies": {},
  "npmDevDependencies": {},
  "environmentVariables": [],
  "files": {
    "atomic": [
      {
        "source": "templates/audit-log.ts",
        "target": "{{aliases.infrastructure}}/audit-log.ts"
      }
    ],
    "feature": [
      {
        "source": "templates/audit-log.ts",
        "target": "{{aliases.infrastructure}}/audit-log.ts"
      }
    ],
    "hybrid": [
      {
        "source": "templates/audit-log.ts",
        "target": "{{aliases.infrastructure}}/audit-log.ts"
      }
    ]
  },
  "instructions": [
