{
  "name": "storage-vercel-blob",
  "version": "1.0.0",
  "description": "Vercel Blob storage adapter",
  "supportedArchitectures": ["atomic", "feature", "hybrid"],
  "dependencies": [],
  "npmDependencies": {
    "@vercel/blob": "2.6.1"
  },
  "npmDevDependencies": {},
  "environmentVariables": [
    {
      "name": "BLOB_READ_WRITE_TOKEN",
      "description": "Vercel Blob server token",
      "required": true
    }
  ],
  "files": {
    "atomic": [
      {
        "source": "templates/storage.ts",
        "target": "{{aliases.infrastructure}}/storage.ts"
      }
    ],
    "feature": [
      {
        "source": "templates/storage.ts",
        "target": "{{aliases.infrastructure}}/storage.ts"
      }
    ],
    "hybrid": [
      {
        "source": "templates/storage.ts",
        "target": "{{aliases.infrastructure}}/storage.ts"
      }
    ]
  },
  "instructions": [
    "Vercel Blob public stores expose durable URLs; use private access and authenticated delivery for sensitive files."
  ]
}
