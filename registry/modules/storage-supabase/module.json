{
  "name": "storage-supabase",
  "version": "1.0.0",
  "description": "Private-by-default Supabase Storage adapter",
  "supportedArchitectures": [
    "atomic",
    "feature",
    "hybrid"
  ],
  "supportedBackends": [
    "supabase"
  ],
  "dependencies": [
    "error-handling"
  ],
  "npmDependencies": {
    "@supabase/supabase-js": "2.112.0"
  },
  "npmDevDependencies": {},
  "environmentVariables": [
    {
      "name": "SUPABASE_SERVICE_ROLE_KEY",
      "description": "Server-only Supabase service role key",
      "required": true
    },
    {
      "name": "SUPABASE_STORAGE_BUCKET",
      "description": "Private storage bucket",
      "required": true
    }
  ],
  "files": {
    "atomic": [
      {
        "source": "templates/storage.ts",
        "target": "{{aliases.infrastructure}}/storage.ts"
      }
    ],
    "feature": [
      {
        "source": "templates/storage.ts",
        "target": "{{aliases.infrastructure}}/storage.ts"
      }
    ],
    "hybrid": [
      {
        "source": "templates/storage.ts",
        "target": "{{aliases.infrastructure}}/storage.ts"
      }
    ]
  },
  "instructions": [
    "Keep the bucket private; issue short-lived signed URLs after authorization."
  ],
  "exports": [
    {
      "name": "storage",
      "path": "{{aliases.infrastructure}}/storage.ts",
      "description": "Supabase storage adapter"
    },
    {
      "name": "getSignedUrl",
      "path": "{{aliases.infrastructure}}/storage.ts",
      "description": "Signed read URL"
    }
  ],
  "governance": {
    "owner": "opencraft",
    "classification": "core",
    "lifecycle": "stable",
    "reviewCadence": "quarterly"
  }
}
