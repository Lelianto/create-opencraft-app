    "atomic",
    "feature",
    "hybrid"
  ],
  "dependencies": [],
  "npmDependencies": {},
  "npmDevDependencies": {},
  "environmentVariables": [],
  "files": {
    "atomic": [
      {
        "source": "templates/search-filter.tsx",
        "target": "{{aliases.components}}/molecules/search-filter.tsx"
      }
    ],
    "feature": [
      {
        "source": "templates/search-filter.tsx",
        "target": "{{aliases.components}}/search-filter.tsx"
      }
    ],
    "hybrid": [
      {
        "source": "templates/search-filter.tsx",
