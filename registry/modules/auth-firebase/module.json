{
  "name": "auth-firebase",
  "version": "1.0.0",
  "description": "Server-verified Firebase authentication",
  "supportedArchitectures": [
    "atomic",
    "feature",
    "hybrid"
  ],
  "supportedBackends": [
    "firebase"
  ],
  "dependencies": [
    "error-handling"
  ],
  "npmDependencies": {
    "firebase": "12.17.0",
    "firebase-admin": "14.2.0"
  },
  "npmDevDependencies": {},
  "environmentVariables": [
    {
      "name": "NEXT_PUBLIC_FIREBASE_API_KEY",
      "description": "Firebase web API key",
      "required": true
    },
    {
      "name": "FIREBASE_PROJECT_ID",
      "description": "Firebase project ID",
      "required": true
    },
    {
      "name": "FIREBASE_CLIENT_EMAIL",
      "description": "Service account client email",
      "required": true
    },
    {
      "name": "FIREBASE_PRIVATE_KEY",
      "description": "Service account private key",
      "required": true
    }
  ],
  "files": {
    "atomic": [
      {
        "source": "templates/auth.ts",
        "target": "{{aliases.infrastructure}}/auth.ts"
      },
      {
        "source": "templates/session.ts",
        "target": "src/app/api/auth/session/route.ts"
      }
    ],
    "feature": [
      {
        "source": "templates/auth.ts",
        "target": "{{aliases.infrastructure}}/auth.ts"
      },
      {
        "source": "templates/session.ts",
        "target": "src/app/api/auth/session/route.ts"
      }
    ],
    "hybrid": [
      {
        "source": "templates/auth.ts",
        "target": "{{aliases.infrastructure}}/auth.ts"
      },
      {
        "source": "templates/session.ts",
        "target": "src/app/api/auth/session/route.ts"
      }
    ]
  },
  "instructions": [
    "Store the Firebase private key only in server-side environment variables and deploy restrictive Security Rules."
  ],
  "exports": [
    {
      "name": "getCurrentUser",
      "path": "{{aliases.infrastructure}}/auth.ts",
      "description": "Server-side session lookup"
    },
    {
      "name": "requireUser",
      "path": "{{aliases.infrastructure}}/auth.ts",
      "description": "Server-side session enforcement"
    },
    {
      "name": "POST",
      "path": "src/app/api/auth/session/route.ts",
      "description": "Create session route"
    },
    {
      "name": "DELETE",
      "path": "src/app/api/auth/session/route.ts",
      "description": "Destroy session route"
    }
  ],
  "governance": {
    "owner": "opencraft",
    "classification": "core",
    "lifecycle": "stable",
    "reviewCadence": "quarterly"
  }
}
