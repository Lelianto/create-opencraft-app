{
  "name": "auth-supabase",
  "version": "1.0.0",
  "description": "Server-verified Supabase authentication",
  "supportedArchitectures": ["atomic", "feature", "hybrid"],
  "supportedBackends": ["supabase"],
  "dependencies": ["error-handling"],
  "npmDependencies": {
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.0"
  },
  "npmDevDependencies": {},
  "environmentVariables": [
    {
      "name": "NEXT_PUBLIC_SUPABASE_URL",
      "description": "Supabase project URL",
      "required": true
    },
    {
      "name": "NEXT_PUBLIC_SUPABASE_ANON_KEY",
      "description": "Supabase publishable/anon key",
      "required": true
    },
    {
      "name": "NEXT_PUBLIC_APP_URL",
      "description": "Canonical public origin used for callback redirect validation",
      "required": false
    }
  ],
  "files": {
    "atomic": [
      {
        "source": "templates/auth.ts",
        "target": "{{aliases.infrastructure}}/auth.ts"
      },
      {
        "source": "templates/callback.ts",
        "target": "src/app/auth/callback/route.ts"
      }
    ],
    "feature": [
      {
        "source": "templates/auth.ts",
        "target": "{{aliases.infrastructure}}/auth.ts"
      },
      {
        "source": "templates/callback.ts",
        "target": "src/app/auth/callback/route.ts"
      }
    ],
    "hybrid": [
      {
        "source": "templates/auth.ts",
        "target": "{{aliases.infrastructure}}/auth.ts"
      },
      {
        "source": "templates/callback.ts",
        "target": "src/app/auth/callback/route.ts"
      }
    ]
  },
  "instructions": [
    "Enable Google in Supabase Authentication providers, register the /auth/callback URL, and set NEXT_PUBLIC_APP_URL."
  ]
}
