{
  "name": "user-profile",
  "version": "2.0.0",
  "description": "Authenticated profile page showing the verified current user",
  "supportedArchitectures": [
    "atomic",
    "feature",
    "hybrid"
  ],
  "supportedBackends": [
    "supabase",
    "firebase"
  ],
  "dependencies": [],
  "npmDependencies": {},
  "npmDevDependencies": {},
  "environmentVariables": [],
  "files": {
    "atomic": [
      {
        "source": "templates/page.tsx",
        "target": "src/app/profile/page.tsx"
      }
    ],
    "feature": [
      {
        "source": "templates/page.tsx",
        "target": "src/app/profile/page.tsx"
      }
    ],
    "hybrid": [
      {
        "source": "templates/page.tsx",
        "target": "src/app/profile/page.tsx"
      }
    ]
  },
  "instructions": [
    "Requires an installed auth module exporting requireUser from @/infrastructure/auth. Profile data always comes from the server-verified session."
  ],
  "exports": [
    {
      "name": "ProfilePage",
      "path": "src/app/profile/page.tsx",
      "description": "Authenticated profile page"
    }
  ],
  "governance": {
    "owner": "opencraft",
    "classification": "standard",
    "lifecycle": "stable",
    "reviewCadence": "yearly"
  }
}
