{
  "name": "rate-limit",
  "version": "1.0.0",
  "description": "Provider-neutral rate-limit contract with safe development adapter",
  "supportedArchitectures": [
    "atomic",
    "feature",
    "hybrid"
  ],
  "dependencies": [],
  "npmDependencies": {},
  "npmDevDependencies": {},
  "environmentVariables": [],
  "files": {
    "atomic": [
      {
        "source": "templates/rate-limit.ts",
        "target": "{{aliases.infrastructure}}/rate-limit.ts"
      }
    ],
    "feature": [
      {
        "source": "templates/rate-limit.ts",
        "target": "{{aliases.infrastructure}}/rate-limit.ts"
      }
    ],
    "hybrid": [
      {
        "source": "templates/rate-limit.ts",
        "target": "{{aliases.infrastructure}}/rate-limit.ts"
      }
    ]
  },
  "instructions": [
